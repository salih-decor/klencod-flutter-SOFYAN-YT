# ── مفاتيح تبقى على الخادم فقط ──
ANTHROPIC_API_KEY=ضع_المفتاح_هنا
SOFYAN_MODEL=claude-sonnet-5-5

# سرّ توقيع جلسات الدخول (أنشئه بـ: python -c "import secrets;print(secrets.token_urlsafe(48))")
SOFYAN_JWT_SECRET=غيّرني_إلى_قيمة_عشوائية_طويلة

# بريد المشرفين (مفصولة بفواصل): فقط هؤلاء يستطيعون إضافة ملفات "مشتركة" لكل المستخدمين
ADMIN_EMAILS=admin@example.com

# true/false: السماح بإنشاء حسابات جديدة
ALLOW_REGISTRATION=true

# مجلد البيانات (قاعدة SQLite + ملفات المكتبة)
SOFYAN_DATA_DIR=./data

# مسار Tesseract على ويندوز فقط (على Linux/Docker لا حاجة له):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# نطاق الخادم لـ docker-compose (HTTPS تلقائي)
DOMAIN=api.example.com
